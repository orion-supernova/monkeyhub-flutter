<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- WebRTC calls: audio routing, Bluetooth headset connect, foreground
         service for keeping the call alive when the app is backgrounded. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Lets the app open the "ignore battery optimizations" system prompt so
         OEM power managers (Xiaomi/Samsung/Oppo…) don't defer the high-priority
         FCM call wake. Requested once post-login; see AndroidCallReliability. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Location sharing. Four permissions, three tiers, and the difference
         between them is what the Play Console declaration has to describe.

         ACCESS_COARSE_LOCATION is listed alongside FINE because Android 12+
         lets the user grant "approximate" instead, and an app that declares
         only FINE has that choice taken away from it — the system shows the
         precise/approximate toggle only when both are declared. A coarse fix
         is a legitimate answer here: the bubble draws the accuracy it was
         given, so a 1 km radius renders as a 1 km radius.

         FOREGROUND_SERVICE_LOCATION is what lets LiveLocationService promote
         the process while a share runs, which is what stops Android throttling
         location to a few updates an hour and then killing us. Started while
         the app is on screen, so it needs NO background permission — this is
         the tier almost everybody will use.

         ACCESS_BACKGROUND_LOCATION is requested separately, later, and only
         from somebody who has started a live share and chosen the "pick it back
         up" option in an explainer sheet. It buys exactly one thing: the boot
         receiver below can restart a share after a reboot. Declining it costs
         nothing else — see LIVE_LOCATION_BACKGROUND.md, which is also the
         Play declaration this permission requires.

         RECEIVE_BOOT_COMPLETED is the boot receiver's trigger. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="MonkeyHub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- launchMode/taskAffinity are load-bearing for calls. Accepting a
             call relaunches us through flutter_callkit_incoming's
             TransparentActivity, which starts our launch intent with
             SINGLE_TOP|CLEAR_TOP and no NEW_TASK — so it can only find this
             activity if the two share a task affinity. An empty affinity
             matches nothing, which spawned a SECOND MainActivity (and a
             second Dart isolate) on every answer; the duplicate's accept
             watchdog then hung up the real call. Leave the affinity at the
             package default and keep singleTask so one instance exists no
             matter which path launches us. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enabled="true">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Direct Share. The system reads this from whichever component
                 is the CURRENT launcher entry, which is why the identical line
                 is repeated on every <activity-alias> below: applyAlternateIcon
                 disables this activity whenever a themed icon is chosen, and
                 the alias that replaces it has to carry the declaration or the
                 suggestion row silently empties. See res/xml/share_targets.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_targets" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Room invite links. `autoVerify` is what makes this an App Link
                 rather than just another handler in a chooser dialog: at
                 install time Android fetches
                 https://monkeyhub.walhallaa.com/.well-known/assetlinks.json
                 and, if this package and the signing certificate's SHA-256
                 fingerprint are listed there, opens the URL here with no
                 disambiguation prompt at all.

                 Verification is per-INSTALL and needs the network. It fails
                 silently — the link simply opens in a browser — and the only
                 way to see why is
                 `adb shell pm get-app-links com.walhallaa.chattest20241220`.
                 The Play-signed certificate is a DIFFERENT fingerprint from a
                 locally-signed build, so assetlinks.json has to carry both or
                 Play installs never verify. See DEEP_LINKS.md.

                 The path prefix is deliberately narrow. `/` would claim every
                 URL on the site — the landing page, /downloads/, the Flutter
                 web app at /web/ — and an app that swallows its own download
                 page is a very confusing thing to debug. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="monkeyhub.walhallaa.com"
                    android:pathPrefix="/j/" />
            </intent-filter>

            <!-- The fallback door, for a device whose App Link verification
                 failed. Never shared; see lib/invites/invite_link.dart. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="monkeyhub" />
            </intent-filter>
        </activity>

        <!-- Receives the backend's data-only call pushes (voipPush.ts) and
             shows/dismisses the flutter_callkit_incoming full-screen call UI —
             the Android mirror of the iOS PushKit handler in AppDelegate.swift.
             OneSignal's own pushes bypass this service (it filters them in its
             high-priority FCMBroadcastReceiver). -->
        <service
            android:name=".CallFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keeps a live location share publishing while the app is off screen.
             Not a location provider — geolocator still takes the fixes from the
             Dart isolate — this only keeps that isolate alive and unthrottled,
             and owns the notification with the STOP button that geolocator's
             own foreground-service notification cannot have.

             The type must match the ServiceInfo constant passed to
             startForeground() or Android 14+ throws rather than degrading.
             Not exported: nothing outside this app has any business starting
             or stopping somebody's location share. -->
        <service
            android:name=".LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- The foreground service a screen share needs on Android 14:
             createVirtualDisplay refuses to run unless a mediaProjection-typed
             service is up, and the call service (the callkit plugin's) is not
             ours to retype. Started from Dart after consent, before capture;
             dies with the task, because a share never outlives the call. -->
        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="true" />

        <!-- Restarts an unexpired share after a reboot. Reads the deadline out
             of shared_preferences and does nothing at all in the overwhelmingly
             common case where no share is running — booting a Flutter engine to
             discover that on every boot is the cost this avoids.

             NOT direct-boot aware, and LOCKED_BOOT_COMPLETED is deliberately not
             listed: the share's deadline lives in credential-encrypted storage
             (shared_preferences) and the session lives in the keystore, neither
             of which is readable before the first unlock. So the honest
             behaviour is what happens anyway — a phone that reboots in a pocket
             resumes its share when it is next unlocked, not before. -->
        <receiver
            android:name=".LiveLocationBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- HTC/older-OEM alias for the same event. Harmless where it is
                     not sent, and the receiver is idempotent where both are. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Full-screen ExoPlayer surface for tapped video messages, launched
             over MainActivity by the monkeyhub/video channel. Not exported:
             nothing outside this app has any business handing it a URL.

             configChanges keeps a rotation from tearing down the player and
             restarting the video (onSaveInstanceState covers the rebuilds it
             cannot claim). -->
        <activity
            android:name=".VideoPlayerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|density|uiMode|locale|layoutDirection|fontScale"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing" />

        <!-- The app's entry in the system share sheet.

             A dedicated activity rather than an intent-filter on MainActivity,
             and that is load-bearing rather than tidy: applyAlternateIcon
             DISABLES .MainActivity whenever one of the aliases below is the
             active launcher icon, and a disabled component resolves to nothing
             — so the app would vanish from the share sheet for exactly the
             users who bothered to pick a themed icon. Nothing enables or
             disables this one.

             It is also the `targetClass` of the <share-target> in
             res/xml/share_targets.xml, for the same reason.

             Translucent and with no layout: it copies the shared content out of
             the sender's provider (see ShareIntake — the content:// grant is
             scoped to THIS activity and dies with it, which is why the copy
             happens before it finishes), then starts the app the same way a
             notification tap does. The user sees the share sheet dismiss and
             MonkeyHub open, and nothing in between.

             excludeFromRecents keeps an invisible entry out of the task
             switcher; noHistory means a share the user abandoned by pressing
             home cannot be resurrected by returning to it. -->
        <activity
            android:name=".ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|locale|layoutDirection|fontScale|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

