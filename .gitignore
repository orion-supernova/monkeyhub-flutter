# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
backend/node_modules/**
# Running npx from the repo root (rather than backend/) leaves one here.
node_modules/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Gradle scratch from building the vendored convex_flutter Android plugin.
# /build/ above is root-anchored, so it never covered these. Regenerated on
# every Android build; the plugin's sources themselves ARE tracked.
/third_party/convex_flutter/android/.gradle/
/third_party/convex_flutter/android/build/
/third_party/flutter_callkit_incoming/android/.gradle/
/third_party/flutter_callkit_incoming/android/build/
/third_party/flutter_webrtc/android/.gradle/
/third_party/flutter_webrtc/android/build/
/third_party/whisper_ggml/android/.gradle/
/third_party/whisper_ggml/android/build/

# Cargo scratch from building the vendored plugin's Rust crate, and the lockfile
# `flutter_rust_bridge_codegen generate` drops while resolving the package. The
# crate's Cargo.lock IS tracked — it pins the convex crate the socket behaviour
# in ConnectionHealth is reasoned against.
/third_party/convex_flutter/rust/target/
/third_party/convex_flutter/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Env / secrets — never commit. Use env.example as the template.
/env.local
/env.*.local
# Deploy-only secrets read by deploy.sh (App Store Connect API key).
# Distinct from env.local (no dot), which is bundled into the IPA.
/.env.local
/backend/.env.local
/backend/.env*.local
# VAPID signing key for Web Push. Lives in Convex deployment env; this is the
# local copy kept so the pair can be restored. Rotating it re-mints every
# browser's push subscription, so it is worth not losing — and worth not
# committing.
/vapid_pkcs8.pem
/vapid.pem

android/.kotlin/sessions/

# Page staging area — hosting/public/{site,downloads}/ is regenerated from the
# templates in hosting/ by deploy.sh, and stages any (large) installer before it
# is rsynced to the VM. The templates themselves ARE tracked.
/hosting/public/
/.firebase/
firebase-debug.log

# graphify: generated knowledge-graph output (1GB+, regenerate with `graphify update .`)
# Tracked snapshots of graph.json were purged from history 2026-08-27; keep them out.
/graphify-out/*
!/graphify-out/GRAPH_REPORT.md
/backend/graphify-out/

# Cloudflare tunnel secrets. hosting/ampere/cloudflared/ holds the ingress
# configs, which are safe to track — but the credentials JSON and the account
# cert that migrate-to-ampere.sh copies alongside them are NOT. Whoever holds a
# tunnel's credentials file can serve that hostname.
hosting/ampere/cloudflared/*.json
hosting/ampere/cloudflared/cert.pem
