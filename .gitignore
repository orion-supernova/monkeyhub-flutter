# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
backend/node_modules/**

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Gradle scratch from building the vendored convex_flutter Android plugin.
# /build/ above is root-anchored, so it never covered these. Regenerated on
# every Android build; the plugin's sources themselves ARE tracked.
/third_party/convex_flutter/android/.gradle/
/third_party/convex_flutter/android/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Env / secrets — never commit. Use env.example as the template.
/env.local
/env.*.local
# Deploy-only secrets read by deploy.sh (App Store Connect API key).
# Distinct from env.local (no dot), which is bundled into the IPA.
/.env.local
/backend/.env.local
/backend/.env*.local

android/.kotlin/sessions/

# Page staging area — hosting/public/{site,downloads}/ is regenerated from the
# templates in hosting/ by deploy.sh, and holds the (large) APK before it is
# rsynced to the VM. The templates themselves ARE tracked.
/hosting/public/
/.firebase/
firebase-debug.log
