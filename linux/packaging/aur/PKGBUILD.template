# Maintainer: Murat Can Koç
#
# Generated by deploy.sh from linux/packaging/aur/PKGBUILD.template — edit the
# template, not the AUR repo. __VERSION__ / __SHA256__ / __URL__ are filled in
# per release; SRCINFO.template must be kept in step with this file by hand
# (deploy.sh runs on a Mac, so there is no makepkg to regenerate it).
pkgname=monkeyhub-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="Chats, calls and moments with your inner circle"
arch=('x86_64')
url="https://monkeyhub.walhallaa.com"
license=('LicenseRef-proprietary')
depends=('gtk3' 'libsecret' 'jsoncpp')
provides=('monkeyhub')
conflicts=('monkeyhub')
options=('!strip' '!debug')
source=("monkeyhub-linux-x64-${pkgver}.tar.gz::__URL__")
sha256sums=('__SHA256__')

package() {
    install -d "$pkgdir/opt/monkeyhub" "$pkgdir/usr/bin"
    cp -r monkeyhub/. "$pkgdir/opt/monkeyhub/"
    rm "$pkgdir/opt/monkeyhub/monkeyhub.desktop" "$pkgdir/opt/monkeyhub/monkeyhub.png"
    # Flutter finds data/ and lib/ via /proc/self/exe, which resolves the link.
    ln -s /opt/monkeyhub/monkeyhub "$pkgdir/usr/bin/monkeyhub"
    install -Dm644 monkeyhub/monkeyhub.desktop "$pkgdir/usr/share/applications/monkeyhub.desktop"
    install -Dm644 monkeyhub/monkeyhub.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/monkeyhub.png"
}
