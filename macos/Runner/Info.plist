<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleDisplayName</key>
	<string>MonkeyHub</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MonkeyHub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Required for Mac App Store upload (error 90242 without it) — Xcode only
	     warns at archive time, ASC's server rejects the upload outright. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<!-- Export compliance, declared the same way ios/Runner/Info.plist declares
	     it. Without it the upload SUCCEEDS and then parks in App Store Connect
	     as "Missing Compliance", which never reaches a tester — the macOS build
	     simply is not listed in TestFlight and there is nothing on the Mac to
	     explain why. False because the app ships no non-exempt cryptography of
	     its own: everything is HTTPS/TLS through the OS. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Google Sign-In. On macOS the consent page opens in the DEFAULT BROWSER
	     — a real Chrome/Safari window, not the in-app sheet iOS gets — and
	     Google hands control back through the app's own URL scheme, which is
	     the iOS OAuth client id REVERSED. With no scheme claimed here the
	     callback has nowhere to land: the browser is left sitting on the
	     redirect and the button spins forever, because none of our code ever
	     runs again to fail or cancel.

	     Same two keys as ios/Runner/Info.plist, and GOOGLE_IOS_CLIENT_ID in
	     env.local is the third copy — all three have to stay in step. GIDClientID
	     is belt-and-braces (SocialSignIn passes the id to `initialize()`
	     explicitly), the URL scheme is not.

	     The *iOS* client is correct here: Google issues no separate macOS
	     client type, and its own docs point Mac apps at the iOS one. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.691782206017-5shp2ce3g12b8raojl263fg6u711jrhr</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>691782206017-5shp2ce3g12b8raojl263fg6u711jrhr.apps.googleusercontent.com</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>MonkeyHub shares your screen with the people on your call when you ask it to.</string>
	<key>NSCameraUsageDescription</key>
	<string>This app requires access to your camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app requires access to your microphone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app requires access to your photo library.</string>
	<!-- Location sharing. Present because `geolocator_macos` is now registered
	     on this platform and CoreLocation terminates a process that asks for a
	     fix without a usage string — a missing key here is a crash, not a
	     refusal. Paired with com.apple.security.personal-information.location
	     in both entitlements files, which the sandbox requires as well. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MonkeyHub uses your location only when you choose to share it in a chat. Live shares stop by themselves at the time you pick.</string>
</dict>
</plist>
