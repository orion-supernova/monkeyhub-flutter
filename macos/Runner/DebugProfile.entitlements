<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- Location sharing. The sandbox needs this in addition to the
	     NSLocationWhenInUseUsageDescription string in Info.plist; without it
	     CoreLocation refuses every request without ever prompting. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- flutter_secure_storage uses the Data Protection Keychain on macOS
	     (kSecUseDataProtectionKeychain), and per Apple/Google's own guidance
	     (see macos/Pods/GTMAppAuth/README.md, "macOS" under "Keychain
	     Storage"), a sandboxed app that doesn't specify an access group MUST
	     list this one or Keychain reads/writes are unreliable across process
	     launches. Without it, SessionStore/ServerStore silently lost their
	     saved session on relaunch — the app always fell back to the login
	     screen. Same value in Release.entitlements. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<!-- Sign in with Apple. macOS shows the button too — SocialSignIn.appleAvailable
	     is true for iOS *and* macOS — so this key has to be here as well as in
	     ios/Runner/Runner.entitlements. Without it ASAuthorizationController
	     refuses every request with a bare "The operation couldn't be completed"
	     (AuthorizationError 1000): no sheet, no account picker, nothing to tell
	     the user or us that a capability is missing rather than Apple being
	     down. The Mac Team profile already grants it, so nothing changes in the
	     developer portal. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal links. `applinks:` is the invite link
	     (https://monkeyhub.walhallaa.com/j/<code>) — see
	     lib/invites/invite_link.dart and DEEP_LINKS.md.

	     THREE things have to agree or the tap silently opens Safari instead
	     of the app, with no error anywhere:
	       1. this entitlement,
	       2. Associated Domains enabled on the App ID in the developer
	          portal (signing does NOT fail without it — the capability is
	          simply absent from the profile),
	       3. https://monkeyhub.walhallaa.com/.well-known/apple-app-site-association
	          served as application/json, no redirect, no extension.

	     Apple's CDN caches the AASA for up to 24h, so a fix to (3) is not
	     visible on a device that has already fetched a bad copy until the app
	     is reinstalled. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:monkeyhub.walhallaa.com</string>
	</array>
</dict>
</plist>
