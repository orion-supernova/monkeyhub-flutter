  "howToPatches3": "पैच काटने के लिए एक कोने से दूसरे कोने तक खींचो। हटाने के लिए पैच पर टैप करो।",
  "howToPatches4": "किनारे से सटा बड़ा सुराग अक्सर एक ही तरह फ़िट होता है। वहीं से शुरू करो।",
  "howToCode1": "4 अलग-अलग सिंबल का एक सीक्रेट कोड है, कोई सिंबल रिपीट नहीं होता। उसे तोड़ो।",
  "howToCode2": "हरा: सही सिंबल, सही जगह।",
  "howToCode3": "पीला: कोड में है, पर कहीं और। ग्रे: कोड में है ही नहीं।",
  "howToCode4": "6 मौके मिलते हैं। जितने कम में करो, उतना बढ़िया।",
  "howToCodeTip": "पहले अंदाज़े नए सिंबल आज़माने में लगाओ। सीखना, तुक्के से बेहतर है।",
  "howToTtt1": "बारी-बारी अपना निशान लगाओ। 3 एक लाइन में लगाओ और जीत जाओ।",
  "howToTtt2": "सामने वाले के 2 एक लाइन में हैं? तीसरा खाना पहले तुम ले लो।",
  "howToC41": "किसी कॉलम पर टैप करो और डिस्क गिराओ। वो सबसे नीचे वाली खाली जगह पर गिरेगी।",
  "howToC42": "4 एक लाइन में लगाओ और जीतो: आड़ी, खड़ी या तिरछी।",
  "howToC4Tip": "बीच वाला कॉलम खेलो। वह बाकी किसी भी कॉलम से ज़्यादा चौकों का हिस्सा है।",
  "howToCheckers1": "गोटियाँ एक खाना तिरछा आगे चलती हैं। गोटी पर टैप करो, फिर जहाँ ले जाना है।",
  "howToCheckers2": "विरोधी की गोटी के ऊपर से कूदो और उसे ले लो। कूद सकते हो तो कूदना ही पड़ेगा। जिस गोटी को कूदना है उस पर घेरा दिखेगा।",
  "howToCheckers3": "उतरकर फिर से कूद सकते हो? कूदते रहो। एक ही चाल में कई गोटियाँ ले सकते हो।",
  "howToCheckers4": "दूसरी तरफ़ पहुँचते ही गोटी राजा बन जाती है। राजा पीछे भी चल सकता है, पर एक बार में सिर्फ़ एक खाना।",
  "howToCheckersWin": "सारी गोटियाँ ले लो या सामने वाले की कोई चाल न बचे, तो तुम जीते। दोनों की 40-40 चालों तक न कोई गोटी मरे, न कोई आम गोटी चले, तो बराबरी।",
  "howToCheckersTip": "अपनी पिछली लाइन अपनी जगह रखो। इससे वो किंग नहीं बना पाएँगे।",
  "howToReversi1": "डिस्क ऐसे रखो कि सामने वाले की डिस्क की एक लाइन तुम्हारी दो डिस्क के बीच फँस जाए। हर चाल में कम से कम एक डिस्क फँसनी चाहिए।",
  "howToReversi2": "फँसी हुई हर डिस्क तुम्हारे रंग की हो जाती है, हर दिशा में एक साथ।",
  "howToReversi3": "कोई चाल नहीं बची? तुम्हारी बारी छूट जाएगी। जब कोई नहीं चल पाए, सबसे ज़्यादा डिस्क वाला जीतता है।",
  "howToReversiTip": "कोने पकड़ो। कोने वाली डिस्क कभी पलटी नहीं जा सकती।",
  "howToDots1": "बारी-बारी दो डॉट के बीच एक लाइन खींचो।",
  "howToDots2": "डिब्बा बंद किया तो वो तुम्हारा। और फिर से तुम्हारी बारी!",
  "howToDots3": "डिब्बे की तीसरी लाइन से बचो। वो अगले खिलाड़ी को डिब्बा तोहफ़े में दे देती है।",
  "howToDotsWin": "आख़िरी लाइन खिंचने पर जिसके सबसे ज़्यादा डिब्बे, वो जीता।",
  "howToChess1": "मोहरे पर टैप करो, देखो वो कहाँ जा सकता है, फिर किसी खाने पर टैप करो।",
  "howToChess2": "विरोधी के मोहरे वाले खाने पर जाओ और उसे मार लो।",
  "howToChess3": "प्यादे को आख़िरी लाइन तक ले जाओ, वो वज़ीर बन जाएगा, या जो तुम चुनो।",
  "howToChess4": "शह का मतलब राजा पर हमला है, उसे बचाना ही पड़ेगा। बचने का रास्ता नहीं? शह-मात, खेल ख़त्म। कोई चाल नहीं बची पर शह भी नहीं है? बराबरी।",
  "howToChessTip": "हर चाल से पहले देखो कि वो क्या मार सकते हैं।",
  "howToLiars1": "सब छुपकर 5 पासे फेंकते हैं। तुम्हें सिर्फ़ अपने दिखते हैं।",
  "howToLiars2": "अपनी बारी पर बोली लगाओ कि पूरी टेबल पर किसी एक नंबर के कम से कम कितने पासे हैं। सबके पासे गिने जाते हैं। जैसे “चार 3”।",
  "howToLiars3": "1 जोकर है: वो किसी भी नंबर की तरह गिना जाता है। बस तब नहीं जब बोली 1 पर ही हो।",
  "howToLiars4": "अगले खिलाड़ी को बोली बढ़ानी होगी: ज़्यादा पासे, या उतने ही पर बड़ा नंबर…",
  "howToLiars5": "…या बोलो “झूठ!”। सब अपने पासे दिखाते हैं और गिनती होती है।",
  "howToLiars6": "कम से कम उतने निकले? “झूठ” बोलने वाला एक पासा खोता है। कम निकले? बोली लगाने वाला खोता है।",
  "howToLiars7": "पासे ख़त्म, तुम बाहर। जिसके पास आख़िर तक पासे बचें, वो जीतता है।",
  "howToLiarsClock": "हर बारी 45 सेकंड की। टाइम ख़त्म तो गेम तुम्हारी तरफ़ से चल देगा।",
  "howToLiarsTip": "पहले अपने पासे गिनो। 1 वाइल्ड हैं, इसलिए बाकियों के लगभग एक-तिहाई पासे तुम्हारी बोली वाले अंक से मिलते हैं।",
  "howToImposter1": "सबको एक ही सीक्रेट शब्द मिलता है। सिवाय धोखेबाज़ के, उसे सिर्फ़ कैटेगरी मिलती है।",
  "howToImposter2": "बारी-बारी एक छोटा सा हिंट दो। दिखाओ कि तुम्हें शब्द पता है, पर बताओ मत।",
  "howToImposterVoice": "वॉइस मोड में: अपना हिंट कॉल पर बोलकर बताओ, फिर हो गया पर टैप करो।",
  "howToImposter3": "फिर सब वोट करते हैं कि उनके हिसाब से धोखेबाज़ कौन है, या वोट छोड़ देते हैं।",
  "howToImposter4": "पकड़ा गया? धोखेबाज़ के पास एक आख़िरी मौका है: शब्द सही बताया तो जीत उसकी। ग़लत इंसान चुना, टाई हुआ या बहुतों ने वोट छोड़ा? धोखेबाज़ जीता।",
  "howToRace1": "सबको एक ही बिल्कुल नई पहेली एक साथ मिलती है।",
  "howToRace2": "अपने फ़ोन पर हल करो। तुम्हारी बार सबको दिखाती है कि तुम कितने क़रीब हो।",
  "howToRace3": "जो पहले ख़त्म करे, वो जीते। तुम्हारे पास 10 मिनट हैं।",
  "howToLive1": "सब एक साथ खेलते हैं। सबने मैं तैयार हूँ पर टैप किया, और खेल शुरू।",
  "howToLive2": "कोई गेम से निकल गया? गेम सबके लिए रुक जाता है। उसके पास वापस आने के लिए 2 मिनट हैं, वरना वो हार जाएगा।",
  "howToLive3": "चैट के बाकी लोग देख सकते हैं। वो सीट माँग सकते हैं, और कोई खिलाड़ी अपनी सीट दे सकता है।",
  "howToTurns1": "अपनी चाल चलो, फिर चाल भेजो पर टैप करो। वो चैट में मैसेज बनकर पहुँच जाएगी।",
  "howToTurns2": "हर चाल के लिए 2 दिन हैं। 20 घंटे बाद हम याद दिलाते हैं, और 12 घंटे की चुप्पी के बाद तुम ख़ुद भी याद दिला सकते हो।",
  "howToTurns3": "2 दिन में चाल नहीं चली? वो हार मानी जाएगी। एक चैट में एक साथ 3 गेम तक।",
