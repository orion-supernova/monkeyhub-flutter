<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets a call-invite banner break through Focus. Without this the
	     payload's `interruption-level: time-sensitive` is silently ignored —
	     no error, no log, the banner just gets swallowed. REQUIRES "Time
	     Sensitive Notifications" enabled on the App ID in the developer
	     portal; if it isn't, signing fails. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Lets an incoming message banner be drawn as a COMMUNICATION
	     notification — the sender's face where the app icon normally sits.
	     The work happens in the Notification Service Extension
	     (ios/NotificationService/), which carries the matching key.

	     REQUIRES "Communication Notifications" enabled on the App ID in the
	     developer portal, and on the extension's App ID
	     (com.walhallaa.chatTest-20241220.NotificationService). Signing does NOT
	     fail without it — the capability is simply absent from the profile, the
	     same quiet way associated-domains fails below — and the banner then
	     renders with the app icon exactly as it did before this shipped. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- The App Group the Share Extension writes into and this app reads back.
	     It is the ONLY channel between the two binaries — see
	     ios/Shared/ShareGroup.swift, which both targets compile.

	     REQUIRES "App Groups" enabled on BOTH App IDs in the Apple Developer
	     portal (the app's and the extension's) with this exact group selected.
	     Signing fails if the capability is missing from an App ID, which is the
	     loud failure. The quiet one is this string differing from the copy in
	     ios/ShareExtension/ShareExtension.entitlements: everything builds,
	     everything signs, and `containerURL` returns nil at runtime with no
	     error anywhere — the share sheet dismisses and nothing happens. See
	     SHARE_SHEET.md. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.walhallaa.monkeyhub</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal links. `applinks:` is the invite link
	     (https://monkeyhub.walhallaa.com/j/<code>) — see
	     lib/invites/invite_link.dart and DEEP_LINKS.md.

	     THREE things have to agree or the tap silently opens Safari instead
	     of the app, with no error anywhere:
	       1. this entitlement,
	       2. Associated Domains enabled on the App ID in the developer
	          portal (signing does NOT fail without it — the capability is
	          simply absent from the profile),
	       3. https://monkeyhub.walhallaa.com/.well-known/apple-app-site-association
	          served as application/json, no redirect, no extension.

	     Apple's CDN caches the AASA for up to 24h, so a fix to (3) is not
	     visible on a device that has already fetched a bad copy until the app
	     is reinstalled. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:monkeyhub.walhallaa.com</string>
	</array>
</dict>
</plist>
