	<true/>
	<!-- Screen sharing on a call. flutter_webrtc's broadcast capturer reads both:
	     the app group whose container holds the socket the extension streams
	     frames through, and the extension's bundle id, which it hands to
	     RPSystemBroadcastPickerView so the picker offers MonkeyHub directly. The
	     extension is generated by tool/setup_ios_broadcast_extension.rb. -->
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.walhallaa.monkeyhub</string>
	<key>RTCScreenSharingExtension</key>
	<string>com.walhallaa.chatTest-20241220.BroadcastExtension</string>
	<key>NSCameraUsageDescription</key>
	<string>MonkeyHub uses your camera for video calls and to take photos and videos you send in chats.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MonkeyHub uses your microphone for voice and video calls and to record voice messages.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MonkeyHub saves photos and videos you choose to keep from your chats to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Shows your recent photos under the camera so you can send one with a tap.</string>
	<!-- With "Limited" access, iOS would otherwise re-offer its select-more
	     sheet on every launch that touches the library. The camera's recents
	     strip offers its own "Manage" button instead. -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<!-- Location sharing. Two tiers, and the difference between them is the
	     whole permission story:

	     WHEN IN USE is what the app asks for first, and it is enough for
	     everything most people will notice — including a live share that keeps
	     publishing while the app is in the background, which the "location"
	     entry in UIBackgroundModes below enables and which needs no ALWAYS.

	     ALWAYS is requested only at the moment a user starts a live share, only
	     once ever, and only after a sheet explaining what it adds: significant-
	     change monitoring, which is the only iOS API that can relaunch a
	     terminated app so a share picks itself back up. Declining it costs
	     nothing but that.

	     Both strings name the feature and the limit rather than the API,
	     because App Review reads them as the user will. See
	     LIVE_LOCATION_BACKGROUND.md for the review justification in full. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MonkeyHub uses your location only when you choose to share it in a chat. Live shares stop by themselves at the time you pick.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Allow always so a live location share you started can pick itself back up if your phone restarts or MonkeyHub is closed. MonkeyHub never uses your location outside a share you started, and every share stops by itself at the time you pick.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>maps</string>
		<string>comgooglemaps</string>
		<string>yandexmaps</string>
		<string>waze</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MonkeyHub uses the local network to connect calls directly between devices on the same Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_mdns._udp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
		<string>voip</string>
		<!-- Live location sharing. Without this key `geolocator` refuses to set
		     allowsBackgroundLocationUpdates at all — it checks this array itself
		     — so its absence does not fail loudly, it just makes every live
		     share stop the moment the app leaves the screen. Works on WHEN IN
		     USE; see the usage descriptions above. -->
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
