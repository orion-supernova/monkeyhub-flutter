	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Google Sign-In. The GoogleSignIn SDK hands off to Safari and needs a URL
	     scheme registered to come back; the scheme is the iOS OAuth client ID
	     with its dot-separated components REVERSED. Public identifiers, not
	     secrets — they ship inside every copy of the binary by design.
	     Sign in with Apple needs nothing here: it is fully native and never
	     leaves the app. -->
	<!-- Declares that this app handles INSendMessageIntent, which is what lets
	     it DONATE one. The donation is how a chat earns its place in the system
	     share sheet's top row — see `donateSendMessage` in AppDelegate.swift and
	     `IntentsSupported` in ios/ShareExtension/Info.plist.

	     All three have to be present. None of them fails loudly: without any one
	     of them the suggestions simply never appear, with no error and nothing
	     in the log. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.691782206017-5shp2ce3g12b8raojl263fg6u711jrhr</string>
			</array>
		</dict>
		<!-- The invite-link fallback door. NOT what gets shared: a shared
		     invite is always the https universal link, which is an ordinary
		     web page for anyone without the app. This scheme exists for the
		     case where the universal link fails to reach us — a link opened
		     from an app that strips the association, or a device whose AASA
		     fetch failed — and for hand-testing with `xcrun simctl openurl`.
		     See lib/invites/invite_link.dart. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.walhallaa.monkeyhub.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>monkeyhub</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>691782206017-5shp2ce3g12b8raojl263fg6u711jrhr.apps.googleusercontent.com</string>
