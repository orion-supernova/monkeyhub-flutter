<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What lets `UNNotificationContent.updating(from:)` render a banner as a
	     COMMUNICATION notification — the sender's face where the app icon
	     normally sits, rather than a thumbnail beside it.

	     REQUIRES "Communication Notifications" enabled on THIS extension's own
	     App ID (com.walhallaa.chatTest-20241220.NotificationService) as well as
	     the app's, and it fails the build loudly if it is missing, the way
	     time-sensitive does next door in Runner.entitlements.

	     Worth knowing because the tooling says otherwise: Xcode's portal
	     database lists this capability as supported on an application and a
	     watchkit2-extension and NOT on an ordinary app extension. That list is
	     wrong — the portal offers the checkbox anyway, and both binaries here
	     ship signed with the entitlement. It is wrong about App Groups on the
	     Share Extension in exactly the same way. Do not use it to conclude a
	     capability is unavailable. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
