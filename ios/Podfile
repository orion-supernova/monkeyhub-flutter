# flutter_webrtc requires iOS 13+; set explicitly so CocoaPods doesn't
# fall back to an older default.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Override onesignal_flutter's default (OneSignalComplete) to exclude
  # OneSignalLocation, which references CoreLocation and triggers Apple's
  # NSLocationWhenInUseUsageDescription requirement. We don't use location.
  pod 'OneSignalXCFramework', '5.5.1', :subspecs => [
    'OneSignal',
    'OneSignalInAppMessages',
  ]

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# OneSignal Notification Service Extension — gives iOS alert pushes confirmed
# delivery, reliable badge increments, and rich media. The Xcode target must
# be created first (File → New → Target → Notification Service Extension,
# named exactly 'OneSignalNotificationServiceExtension'); this block
# self-activates once it exists so `pod install` stays green until then.
# Full steps: NOTIFICATION_SETUP.md at the repo root.
if File.read(File.expand_path('Runner.xcodeproj/project.pbxproj', __dir__)).include?('OneSignalNotificationServiceExtension')
  target 'OneSignalNotificationServiceExtension' do
    use_frameworks!
    pod 'OneSignalXCFramework', '5.5.1', :subspecs => ['OneSignalExtension']
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Register every PNG under ios/Runner/AlternateIcons/ as a Runner resource so
  # iOS's setAlternateIconName actually finds the icon file in the bundle.
  # Idempotent — safe on re-runs.
  load File.expand_path('../tool/setup_ios_alternate_icons.rb', __dir__)
end
