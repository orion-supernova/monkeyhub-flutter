# flutter_webrtc requires iOS 13+; set explicitly so CocoaPods doesn't
# fall back to an older default.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Push needs no pod at all: APNs registration is UserNotifications +
# PushKit, both in the SDK. See ios/Runner/AppDelegate.swift.
target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Register every PNG under ios/Runner/AlternateIcons/ as a Runner resource so
  # iOS's setAlternateIconName actually finds the icon file in the bundle.
  # Idempotent — safe on re-runs.
  load File.expand_path('../tool/setup_ios_alternate_icons.rb', __dir__)

  # Create the ShareExtension target — the app's entry in the system share
  # sheet. It is a second signed binary with its own bundle id, entitlements and
  # Info.plist, generated here rather than committed as unreviewable pbxproj.
  # Idempotent: a second run over a configured project saves nothing.
  #
  # It deliberately takes no pods and is NOT declared as a `target` block above:
  # an extension that inherits the app's Pods xcconfig links the whole Flutter
  # framework into a process that has no engine and no use for one.
  load File.expand_path('../tool/setup_ios_share_extension.rb', __dir__)

  # Create the NotificationService target — the Notification Service Extension
  # that redraws an incoming banner with the sender's face instead of the app
  # icon. Same reasoning and the same idempotency as the line above.
  #
  # AFTER the share extension, not before: both need the app's 'Embed App
  # Extensions' phase, and this script expects to find one rather than create a
  # second. Also takes no pods, for the same reason.
  load File.expand_path('../tool/setup_ios_notification_extension.rb', __dir__)

  # The Broadcast Upload Extension a system-wide screen share needs — see
  # tool/setup_ios_broadcast_extension.rb. Same shape as the two above.
  load File.expand_path('../tool/setup_ios_broadcast_extension.rb', __dir__)
end
