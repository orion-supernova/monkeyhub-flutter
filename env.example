# Copy this file to `env.local` in the project root and fill in real values.
# `env.local` is gitignored — never commit it.
#
# env.local is bundled as a Flutter asset and loaded at startup by
# `flutter_dotenv`. No CLI flag needed:
#
#   flutter run -d macos        # just works
#
# After editing env.local, do a full restart (not just hot reload) so the
# asset bundle picks up the new values.

CONVEX_URL=https://your-convex-deployment.example.com
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000

# Base URL for Convex HTTP actions — currently the /viewOnce stream that serves
# view-once photos. REQUIRED in practice: it defaults to CONVEX_URL, and that
# default is wrong on both deployment styles we run.
#
#   self-hosted behind the usual proxy → https://<host>/http
#       (HTTP actions are the site port, proxied under /http; a request to
#        https://<host>/viewOnce 404s while https://<host>/http/viewOnce works)
#   Convex Cloud                       → https://<deployment>.convex.site
#       (.convex.cloud is the API, .convex.site is HTTP actions — no prefix)
#
# Get it wrong and everything else still works; only opening a view-once photo
# fails, with "couldn't load that photo."
CONVEX_SITE_URL=https://your-convex-deployment.example.com/http

# ── Google Sign-In ──────────────────────────────────────────────────────────
# OPTIONAL. Leave both blank and the "Continue with Google" button is hidden
# entirely, so the app stays shippable until the OAuth clients exist.
#
# Both are PUBLIC identifiers and safe to bundle. The Sign in with Apple .p8 is
# NOT — it goes in Convex deployment env (`npx convex env set APPLE_SIWA_KEY_P8`),
# never here, because this file ships inside the app.
#
# Create both under GCP project `monkeyhub-2b2c6` (NOT the stale
# monkey-hub-fa2a8 / monkeychat-d01f0 projects — see NOTIFICATION_SETUP.md):
#
#   GOOGLE_IOS_CLIENT_ID     iOS OAuth client. Its REVERSED form also has to go
#                            into ios/Runner/Info.plist as a CFBundleURLTypes
#                            entry, plus GIDClientID.
#   GOOGLE_SERVER_CLIENT_ID  the WEB OAuth client. Passed as `serverClientId` on
#                            BOTH platforms so the ID token's `aud` is a single
#                            value — this is the one the backend allow-lists via
#                            `npx convex env set GOOGLE_CLIENT_IDS`. Mixing these
#                            two up is the usual cause of an audience mismatch
#                            that surfaces as "that sign-in didn't go through".
#
# Android also needs an Android OAuth client registered with the SHA-1 of BOTH
# the upload key and Play App Signing's key, then a fresh google-services.json.
# A wrong/missing SHA-1 is the classic DEVELOPER_ERROR / code 10.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
