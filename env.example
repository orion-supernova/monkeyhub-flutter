# Copy this file to `env.local` and fill in real values.
# `env.local` is gitignored — never commit it.
#
# Pass at run/build time:
#   flutter run     -d macos --dart-define-from-file=env.local
#   flutter build ios        --dart-define-from-file=env.local
#
# Every key here corresponds to a String.fromEnvironment(...) in lib/env.dart.

CONVEX_URL=https://your-convex-deployment.example.com
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
